<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="358.0" prefWidth="722.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reeves.finalprojectveyerus.MainController">

    <top>
        <VBox spacing="8" style="-fx-padding: 10;">
            <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="VeyeRus" textFill="#c90000" underline="true" />
            <HBox maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="48.0" prefWidth="698.0" spacing="85.0">
                <VBox>
                    <Label text="Speed" />
                    <Slider fx:id="speedSlider" max="10" min="0" value="5" />
                </VBox>
                <VBox>
                    <Label text="Food" />
                    <Slider fx:id="foodSlider" max="100" min="0" value="40" />
                </VBox>
                <VBox>
                    <Label text="Population" />
                    <Slider fx:id="populationSlider" max="100" min="0" value="20" />
                </VBox>
            <padding>
               <Insets left="105.0" />
            </padding>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox prefHeight="207.0" prefWidth="101.0" spacing="30.0" style="-fx-padding: 10;">
            <Label fx:id="populationLabel" text="Population: 20" />
            <Label fx:id="generationLabel" text="Generations: 0" />
            <Label fx:id="foodLabel" text="Food: 40" />
            <Label fx:id="avgSpeedLabel" text="Avg speed: -" />
        </VBox>
    </left>

    <center>
        <Pane fx:id="arenaPane" maxWidth="-Infinity" prefHeight="234.0" prefWidth="589.0" style="-fx-background-color: #EFF3EE; -fx-border-color: black;" />
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="0.0" prefWidth="0.0" spacing="10" style="-fx-padding: 10;">
            <Button fx:id="resetButton" text="Reset" />
            <Button fx:id="startButton" text="Start" />
            <Button fx:id="pauseButton" text="Pause" />
        </HBox>
    </bottom>

</BorderPane>
